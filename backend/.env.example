# Nedhub Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=production
BASE_URL=https://your-backend-url.com

# Frontend URL for CORS
FRONTEND_URL=https://www.nedhubgh.com
CORS_ORIGINS=https://www.nedhubgh.com,https://nedhubgh.com,https://your-backend-url.com

# JWT Authentication (Required for admin panel)
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=24h

# Brevo Email Configuration (Required for career applications)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=careers@nedhubgh.com
BREVO_SENDER_NAME=Nedhub Careers

# Hubtel Payment Configuration
HUBTEL_CLIENT_ID=your-hubtel-client-id
HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
HUBTEL_POS_ID=your-hubtel-pos-id
HUBTEL_MERCHANT_ACCOUNT_NUMBER=your-merchant-account-number

# MongoDB (Required for production)
MONGODB_URI=mongodb://localhost:27017/nedhub