# Hubtel Payment Configuration
# Get these from your Hubtel Merchant Dashboard: https://hubtel.com/merchant/dashboard

# Hubtel API Credentials (for payment initiation)
HUBTEL_POS_SALES_ID=your_merchant_account_number
HUBTEL_API_KEY=your_hubtel_api_key

# Hubtel OAuth Credentials (for transaction status checks)
HUBTEL_CLIENT_ID=your_oauth_client_id
HUBTEL_CLIENT_SECRET=your_oauth_client_secret

# Hubtel Token URL (usually this is the default)
HUBTEL_TOKEN_URL=https://api-txnstatus.hubtel.com/connect/token

# API Configuration
API_BASE_URL=https://nedhub-production.up.railway.app
FRONTEND_URL=https://nedhub-production.up.railway.app

# Optional: Server Configuration
PORT=3000
NODE_ENV=production
