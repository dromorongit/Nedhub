# Nedhub Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:5500
API_BASE_URL=http://localhost:3000

# =============================================================================
# HUBTEL PAYMENT CREDENTIALS (Ghana Payment Gateway)
# =============================================================================
# Get these from your Hubtel Merchant Dashboard
# https://hubtel.com/merchant/dashboard
HUBTEL_POS_SALES_ID=your_hubtel_pos_sales_id
HUBTEL_API_KEY=your_hubtel_api_key

# Hubtel Endpoints (do not change unless Hubtel updates their API)
HUBTEL_INITIATE_URL=https://payproxyapi.hubtel.com/items/initiate
HUBTEL_STATUS_URL=https://api-txnstatus.hubtel.com/transactions

# =============================================================================
# STRIPE PAYMENT (Alternative - for international cards)
# =============================================================================
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# PAYPAL PAYMENT (Alternative)
# =============================================================================
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# PAYPAL_MODE=sandbox

# =============================================================================
# EMAIL CONFIGURATION (for order confirmations)
# =============================================================================
# SMTP_HOST=smtp.your-email-provider.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password

# =============================================================================
# DATABASE (for production - uncomment if using database)
# =============================================================================
# DATABASE_URL=postgresql://user:password@localhost:5432/nedhub
# MONGODB_URI=mongodb://localhost:27017/nedhub

# =============================================================================
# SECURITY
# =============================================================================
# JWT_SECRET=your-super-secret-jwt-key
# ENCRYPTION_KEY=32-character-encryption-key
